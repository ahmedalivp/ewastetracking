<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".EWasteApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.EWasteTracking"
        android:usesCleartextTraffic="true">

        <!-- Splash Screen Launcher -->
        <activity
            android:name=".ui.auth.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.EWasteTracking.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Authentication -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Role Main Activities -->
        <activity
            android:name=".ui.consumer.ConsumerMainActivity"
            android:exported="false" />
        <activity
            android:name=".ui.facility.FacilityMainActivity"
            android:exported="false" />
        <activity
            android:name=".ui.business.BusinessMainActivity"
            android:exported="false" />
        <activity
            android:name=".ui.admin.AdminMainActivity"
            android:exported="false" />

    </application>

</manifest>
