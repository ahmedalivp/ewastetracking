<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/bg_card"
    app:strokeWidth="1dp"
    app:strokeColor="@color/card_stroke">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_icon_chip"
                android:padding="8dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_inventory"
                    app:tint="@color/primary_green"
                    android:contentDescription="Center Icon" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/tvCenterName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GreenTech Recycling Center"
                    android:textColor="@color/text_headline"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCenterAddress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="45 Eco Boulevard, San Francisco, CA"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvCenterStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VERIFIED"
                android:textColor="@color/status_completed_text"
                android:background="@drawable/bg_status_pill"
                android:backgroundTint="@color/status_completed_bg"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Stats row & GPS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp">

            <TextView
                android:id="@+id/tvCenterStaffCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👥 1 Staff"
                android:textColor="@color/text_secondary"
                android:background="@drawable/bg_status_pill"
                android:backgroundTint="@color/bg_surface_variant"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvCenterDropOffCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="📍 3 Kiosks"
                android:textColor="@color/text_secondary"
                android:background="@drawable/bg_status_pill"
                android:backgroundTint="@color/bg_surface_variant"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvCenterCoords"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="37.77° N, -122.41° E"
                android:textColor="@color/text_tertiary"
                android:textSize="11sp"
                android:gravity="end" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider_color"
            android:layout_marginVertical="12dp" />

        <!-- Action Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQuickApprove"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Approve Access"
                android:textColor="@color/white"
                android:backgroundTint="@color/primary_green"
                android:textSize="12sp"
                app:cornerRadius="10dp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditAccess"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:text="Manage Access"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                app:cornerRadius="10dp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
